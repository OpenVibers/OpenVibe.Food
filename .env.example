# OpenVibe.Food — environment (production: /etc/openvibe/food.env). Names only; never commit values.

NODE_ENV=production
PORT=4970
HOST=127.0.0.1
BASE_URL=https://openvibe.food
TRUST_PROXY=2
# PostgreSQL (ADR-035), written by OpenVibe.Host roles/data/add-service.sh food: the runtime role through PgBouncer,
# the owner on a direct connection (migrations), and Valkey (shared limit counters).
# Without DATABASE_URL, development uses an embedded PGlite database in data/pglite.
DATABASE_URL=
DATABASE_DIRECT_URL=
VALKEY_URL=
VALKEY_PREFIX=ov:food:
# Per-caller limits (server/http/caller-limits.js): requests one caller may make to the API per minute and per hour.
#FOOD_LIMITS_MINUTE=120
#FOOD_LIMITS_HOUR=3000

# OpenVibe.Network: SSO (OAuth client `food`, PKCE S256) and its JWKS; app tokens for audience openvibe.food.
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
OV_OAUTH_CLIENT_ID=food
OV_OAUTH_CLIENT_SECRET=
# OV_OAUTH_REDIRECT_URI=https://openvibe.food/auth/callback
# FOOD_AUDIENCE=openvibe.food

# OpenStreetMap, the two services "food near you" stands on (server/food/places.js). Both are open data under ODbL 1.0
# with published usage policies; server/food/upstream.js paces every call (one a second per host) and caches every
# answer for FOOD_GEO_CACHE_TTL_MS. Tests point these at a stand-in (test/helpers/osm.js); never at the public hosts.
#FOOD_NOMINATIM_URL=https://nominatim.openstreetmap.org
#FOOD_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Identifies OpenVibe.Food to OSM, as both policies require. Defaults to OpenVibeFood/0.1 (+<BASE_URL>).
#FOOD_OSM_USER_AGENT=
# The pace between two requests to the same host, in ms (the policies ask for at least 1000).
#FOOD_OSM_MIN_INTERVAL_MS=1000
#FOOD_OSM_TIMEOUT_MS=25000
# How long a geocode or an area answer is kept, in ms (default 7 days).
#FOOD_GEO_CACHE_TTL_MS=604800000

# optional: defaults to true in production
# COOKIE_SECURE=true
